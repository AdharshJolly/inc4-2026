##############################################
# Required
##############################################

# Server-side admin password (used by /api/admin-auth)
ADMIN_PASSWORD=

##############################################
# Optional
##############################################

# GitHub token used for file uploads and GitHub sync
NEXT_GITHUB_TOKEN=

# Branch to use for GitHub sync (defaults to "development")
NEXT_GITHUB_BRANCH=

# Remote endpoint to receive error logs (leave blank to log locally)
NEXT_ERROR_LOG_ENDPOINT=

##############################################
# Cloudinary (Image Storage)
##############################################

# Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary API key (publishable, safe for client)
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# Cloudinary API secret (server-side only)
CLOUDINARY_API_SECRET=